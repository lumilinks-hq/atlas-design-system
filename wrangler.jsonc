{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-design-system",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  },
  "preview_urls": true,
  "routes": [
    {
      "pattern": "demo-ds.design-harness.com",
      "custom_domain": true
    }
  ]
}
