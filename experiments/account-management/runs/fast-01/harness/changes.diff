diff --git a/src/styles.css b/src/styles.css
index 24127eb..7fdafa8 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -1,5 +1,7 @@
 @import "tailwindcss";
 @import "@heroui/styles";
+@import "../design/component-theme.css";
+@import "../design/layout.css";
 
 html {
   font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
@@ -9,4 +11,104 @@ body {
   margin: 0;
   min-width: 320px;
   min-height: 100vh;
+  background: var(--dh-background);
+  color: var(--dh-text);
+  font-size: var(--dh-type-body);
+  line-height: var(--dh-type-line-height-body);
+}
+
+/* アプリケーションヘッダー。layout.css が持たない画面固有の面だけを定義する */
+.app-header {
+  border-bottom: 1px solid var(--dh-border);
+  background: var(--dh-surface);
+}
+
+.app-header__inner {
+  display: flex;
+  align-items: center;
+  min-height: 56px;
+}
+
+.app-header__title {
+  font-size: var(--dh-type-heading);
+  font-weight: 650;
+  line-height: var(--dh-type-line-height-heading);
+}
+
+/* 一覧 */
+.collection-table__cell--end {
+  text-align: end;
+}
+
+.collection-empty {
+  margin: 0;
+  padding: var(--dh-space-6) 0;
+  color: var(--dh-text-muted);
+  text-wrap: pretty;
+}
+
+.collection-list-mobile__name {
+  margin: 0;
+  font-size: var(--dh-type-body);
+  font-weight: 650;
+}
+
+/* 詳細 */
+.detail-page__actions {
+  display: flex;
+  gap: var(--dh-space-3);
+  align-items: center;
+}
+
+.detail-item {
+  display: grid;
+  gap: var(--dh-space-1);
+}
+
+.detail-item dt {
+  color: var(--dh-text-muted);
+  font-size: var(--dh-type-small);
+}
+
+.detail-item dd {
+  margin: 0;
+  font-size: var(--dh-type-body);
+}
+
+.detail-note {
+  margin: 0;
+  text-wrap: pretty;
+}
+
+/* オーバーレイの寸法は design/components/*.json の layout が正本 */
+.record-drawer {
+  width: 20rem;
+  max-width: 85vw;
+}
+
+.confirm-dialog {
+  max-width: 28rem;
+}
+
+.confirm-dialog__body {
+  display: grid;
+  gap: var(--dh-space-4);
+}
+
+.confirm-dialog__body p {
+  margin: 0;
+  text-wrap: pretty;
+}
+
+@media (min-width: 640px) {
+  .record-drawer {
+    width: 24rem;
+  }
+}
+
+@media (max-width: 767px) {
+  .detail-page__actions {
+    flex-direction: column;
+    align-items: stretch;
+  }
 }
