{
  "$schema": "../schemas/component.schema.json",
  "version": "1.0.0",
  "id": "component.button",
  "name": "Button",
  "implementation": "Button",
  "import": "@heroui/react",
  "variants": ["primary", "secondary", "tertiary", "outline", "ghost", "danger", "danger-soft"],
  "sizes": ["sm", "md", "lg"],
  "defaults": { "variant": "primary", "size": "md" },
  "visual": { "surfaceOwner": "component", "outerShadow": "allowed", "radiusToken": "radius.base" },
  "requirements": [
    "主要操作は一つの領域に一つまで",
    "ラベルは動詞の終止形で書き、サ変動詞の「する」は省略する",
    "対象を明記する場合は「対象を操作」の順で助詞「を」を使う",
    "アイコンだけの場合はaccessible nameを付ける",
    "操作はonPressで扱い、マウス、タッチ、キーボードを同じ経路にする",
    "非同期処理中はloading状態と二重送信防止を持つ"
  ],
  "relatedRules": ["component.approved", "a11y.control-name", "state.loading"]
}
