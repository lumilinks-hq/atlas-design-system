{
  "$schema": "../schemas/component.schema.json",
  "version": "1.0.0",
  "id": "component.chip",
  "name": "Chip",
  "implementation": "Chip",
  "import": "@heroui/react",
  "variants": ["primary", "secondary", "tertiary", "soft"],
  "sizes": ["sm", "md", "lg"],
  "defaults": { "variant": "secondary", "size": "md" },
  "visual": { "surfaceOwner": "component", "outerShadow": "forbidden", "radiusToken": "radius.pill" },
  "requirements": [
    "状態名を文字で表示する",
    "操作要素の代わりに使わない",
    "semantic colorと状態の意味を一致させる"
  ],
  "relatedRules": ["component.approved", "a11y.color-only", "color.semantic"]
}
