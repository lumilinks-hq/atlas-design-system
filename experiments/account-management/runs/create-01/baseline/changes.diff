+export type UpdateCustomerInput = {
+  companyName: string;
+  contactName: string;
+  email: string;
+  status: CustomerStatus;
+};
+
+export type UpdateCustomerResult =
+  | { ok: true; customer: CustomerDetail }
+  | { ok: false; reason: string };
+
+export function updateCustomer(
+  customerId: string,
+  input: UpdateCustomerInput,
+  options: { simulateFailure?: boolean } = {},
+): UpdateCustomerResult {
+  if (options.simulateFailure) {
+    return { ok: false, reason: "変更の保存に失敗しました。時間をおいて再試行してください。" };
+  }
+  const companyName = input.companyName.trim();
+  if (companyName.length === 0) {
+    return { ok: false, reason: "会社名を入力してください。" };
+  }
+  const record = customerRecords.find(({ id }) => id === customerId);
+  if (!record) {
+    return { ok: false, reason: "対象の顧客が見つかりません。" };
+  }
+
+  record.companyName = companyName;
+  record.contactName = input.contactName.trim();
+  record.email = input.email.trim();
+  record.status = input.status;
+
+  return {
+    ok: true,
+    customer: {
+      id: record.id,
+      companyName: record.companyName,
+      contactName: record.contactName,
+      email: record.email,
+      phone: record.phone,
+      status: record.status,
+      note: record.note,
+    },
+  };
+}
