+}
+
+.hero-panel h1,
+.drawer-panel h2 {
+  margin: 0;
+}
+
+.hero-copy {
+  color: #475569;
+  line-height: 1.7;
+  margin: 12px 0 0;
+  max-width: 62ch;
+}
+
+.eyebrow,
+.section-label,
+.field-label {
+  color: #466287;
+  display: block;
+  font-size: 0.82rem;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  margin: 0 0 8px;
+  text-transform: uppercase;
+}
+
+.hero-actions {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: 12px;
+  min-width: 220px;
+}
+
+.state-switcher {
+  color: #334155;
+  display: grid;
+  font-size: 0.95rem;
+  font-weight: 600;
+  gap: 8px;
+  width: 100%;
+}
+
+.state-switcher select,
+.seat-input {
+  appearance: none;
+  background: #fff;
+  border: 1px solid #cbd5e1;
+  border-radius: 16px;
+  color: #0f172a;
+  padding: 12px 14px;
+  width: 100%;
+}
+
+.status-banner {
+  border-radius: 22px;
+  margin: 0 auto 24px;
+  max-width: 1200px;
+}
+
+.content-grid {
+  display: grid;
+  gap: 24px;
+  grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.35fr);
+  margin: 0 auto;
+  max-width: 1200px;
+}
+
+.overview-card {
+  border-radius: 28px;
+  padding: 8px;
+}
+
+.section-header {
+  align-items: flex-start;
+  display: flex;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.metric-grid,
+.confirmation-grid {
+  display: grid;
+  gap: 16px;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.metric-grid div,
+.confirmation-grid div {
+  background: linear-gradient(180deg, rgba(241, 245, 249, 0.96), rgba(255, 255, 255, 0.9));
+  border: 1px solid rgba(203, 213, 225, 0.75);
+  border-radius: 20px;
+  padding: 16px;
+}
+
+.metric-grid dt,
+.confirmation-grid dt,
+.member-table th {
+  color: #64748b;
+  font-size: 0.88rem;
+  font-weight: 600;
+}
+
+.metric-grid dd,
+.confirmation-grid dd {
+  font-size: 1.1rem;
+  font-weight: 700;
+  margin: 8px 0 0;
+}
+
+.inline-note,
+.field-help {
+  color: #475569;
+  line-height: 1.6;
+  margin: 12px 0 0;
+}
+
+.member-table-wrap {
+  overflow-x: auto;
+}
+
+.member-table {
+  border-collapse: collapse;
+  min-width: 100%;
+  width: 100%;
+}
+
+.member-table th,
+.member-table td {
+  border-bottom: 1px solid rgba(226, 232, 240, 0.9);
+  padding: 14px 10px;
+  text-align: left;
+}
+
+.member-table td {
+  color: #1e293b;
+}
+
+.drawer-backdrop {
+  align-items: stretch;
+  background: rgba(15, 23, 42, 0.4);
+  display: flex;
+  inset: 0;
+  justify-content: flex-end;
+  padding: 20px;
+  position: fixed;
+}
+
+.drawer-panel {
+  border-radius: 32px;
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  max-width: 540px;
+  padding: 24px;
+  width: min(100%, 540px);
+}
+
+.drawer-header,
+.drawer-footer {
+  align-items: center;
+  display: flex;
+  gap: 12px;
+  justify-content: space-between;
+}
+
+.drawer-body {
+  display: grid;
+  gap: 20px;
+}
+
+.form-block {
+  display: grid;
+  gap: 10px;
+}
+
+.plan-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+}
+
+.plan-pill {
+  background: #fff;
+  border: 1px solid #cbd5e1;
+  border-radius: 999px;
+  color: #334155;
+  cursor: pointer;
+  padding: 10px 16px;
+}
+
+.plan-pill.is-selected {
+  background: #dbeafe;
+  border-color: #60a5fa;
+  color: #1d4ed8;
+}
+
+.seat-input.is-invalid {
+  border-color: #ef4444;
+}
+
+.field-error {
+  color: #b91c1c;
+  margin: 0;
+}
+
+.confirmation-card {
+  border-radius: 24px;
+}
+
+@media (max-width: 900px) {
+  .content-grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 720px) {
+  .app-shell {
+    padding: 20px 14px 36px;
+  }
+
+  .hero-panel,
+  .drawer-panel {
+    border-radius: 24px;
+    padding: 20px;
+  }
+
+  .hero-panel,
+  .hero-actions,
+  .drawer-header,
+  .drawer-footer {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .metric-grid,
+  .confirmation-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .drawer-backdrop {
+    align-items: flex-end;
+    padding: 12px;
+  }
 }
