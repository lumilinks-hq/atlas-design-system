{
  "name": "design-harness-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "node scripts/verify-site.mjs",
    "design:check": "node scripts/validate-design.mjs",
    "design:conformance": "node scripts/check-design-conformance.mjs",
    "theme:generate": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check",
    "runs:check": "node scripts/validate-runs.mjs",
    "runs:sanitize": "node scripts/sanitize-run-artifacts.mjs",
    "public:audit": "node scripts/audit-public-data.mjs",
    "links:check": "node scripts/check-links.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "skills:check": "node scripts/validate-skills.mjs",
    "mcp:start": "node scripts/mcp/server.mjs",
    "experiment:run": "node scripts/run-experiment.mjs",
    "experiment:finalize": "node scripts/finalize-experiment.mjs",
    "experiment:compare": "node scripts/compare-experiment.mjs",
    "experiment:evaluate": "node scripts/evaluate-experiment.mjs",
    "experiment:measure": "node scripts/measure-experiment.mjs",
    "experiment:review": "node scripts/review-experiment.mjs",
    "experiment:refine": "node scripts/refine-experiment.mjs",
    "experiment:capture": "node scripts/capture-experiment.mjs",
    "experiment:preview": "node scripts/preview-experiment.mjs",
    "demo:check": "pnpm design:check && pnpm theme:check && pnpm design:conformance && pnpm runs:check && pnpm skills:check && pnpm public:audit && pnpm links:check && pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && pnpm bundle:check"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xyflow/react": "12.11.6",
    "ajv": "8.20.0",
    "gen-interface-jp": "0.8.0",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
