{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills-lock.schema.json",
  "type": "object",
  "required": ["skills"],
  "properties": {
    "$schema": { "type": "string" },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["source", "path"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^skills/[a-z0-9-]+$" },
          "ref": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "upstreamPath": { "type": "string", "minLength": 1 },
          "upstreamVersion": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
