{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component.schema.json",
  "type": "object",
  "required": ["id", "name", "implementation", "import", "variants", "sizes", "requirements", "relatedRules"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^component\\." },
    "name": { "type": "string", "minLength": 1 },
    "implementation": { "type": "string", "minLength": 1 },
    "import": { "const": "@heroui/react" },
    "variants": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "sizes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "relatedRules": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
