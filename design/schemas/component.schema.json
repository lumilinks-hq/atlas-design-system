{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component.schema.json",
  "type": "object",
  "required": ["id", "name", "implementation", "import", "variants", "sizes", "defaults", "visual", "requirements", "relatedRules"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^component\\." },
    "name": { "type": "string", "minLength": 1 },
    "implementation": { "type": "string", "minLength": 1 },
    "import": { "const": "@heroui/react" },
    "variants": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "sizes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "defaults": {
      "type": "object",
      "required": ["variant", "size"],
      "properties": {
        "variant": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "required": ["surfaceOwner", "outerShadow", "radiusToken"],
      "properties": {
        "surfaceOwner": { "enum": ["component", "parent", "none"] },
        "outerShadow": { "enum": ["forbidden", "allowed", "required"] },
        "radiusToken": { "type": "string", "pattern": "^radius\\." }
      },
      "additionalProperties": false
    },
    "requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "relatedRules": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "layout": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
