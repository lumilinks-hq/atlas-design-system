{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "example.schema.json",
  "type": "object",
  "required": ["version", "id", "name", "purpose", "pattern", "variant", "composition", "componentUsage", "states", "components", "lint", "evaluation", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "id": { "type": "string", "pattern": "^example\\." },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "pattern": { "type": "string", "pattern": "^pattern\\." },
    "variant": { "type": "string", "minLength": 1 },
    "composition": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "componentUsage": {
      "type": "object",
      "required": ["component.table", "component.toolbar", "component.link", "component.alert-dialog"],
      "properties": {
        "component.table": { "$ref": "#/$defs/tableUsage" },
        "component.toolbar": { "$ref": "#/$defs/toolbarUsage" },
        "component.button": { "$ref": "#/$defs/createActionUsage" },
        "component.drawer": { "$ref": "#/$defs/formDrawerUsage" },
        "component.link": { "$ref": "#/$defs/backNavigationUsage" },
        "component.alert-dialog": { "$ref": "#/$defs/alertDialogUsage" }
      },
      "additionalProperties": false
    },
    "states": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "components": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^component\\." }, "uniqueItems": true },
    "lint": { "$ref": "#/$defs/lintOptions" },
    "evaluation": { "$ref": "#/$defs/evaluationHints" },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false,
  "$defs": {
    "evaluationHints": {
      "type": "object",
      "required": ["requiredFieldLabel", "statusValues", "toolbarAriaLabel", "screenComponents", "readModels"],
      "properties": {
        "requiredFieldName": {
          "type": "string",
          "minLength": 1,
          "description": "必須入力にするフィールドの識別子。省略するとTable契約の行見出し列を使う。行見出し列が編集対象でない題材ではここで指定する"
        },
        "requiredFieldLabel": {
          "type": "string",
          "minLength": 1,
          "description": "必須入力にする項目の業務上の呼び名。評価の証跡に出す語で、Tableの列見出しラベルとは別に持つ"
        },
        "statusValues": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "toolbarAriaLabel": { "type": "string", "minLength": 1 },
        "screenComponents": {
          "type": "object",
          "required": ["collection", "detail"],
          "properties": {
            "collection": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "detail": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "readModels": {
          "type": "object",
          "required": ["summaryType", "detailType", "listFunction", "detailFunction"],
          "properties": {
            "summaryType": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "detailType": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "listFunction": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "detailFunction": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "lintOptions": {
      "type": "object",
      "required": ["linkSemantics", "requiredInputType", "irreversibleActionPattern"],
      "properties": {
        "forbiddenText": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "requiredInputType": {
          "type": "string",
          "minLength": 1,
          "description": "必須入力に求めるinputのtype属性。ブラウザに形式検証させる項目が題材ごとに違うのでexampleが持つ"
        },
        "irreversibleActionPattern": {
          "type": "string",
          "minLength": 1,
          "description": "取り消せない操作を画面ソースから見つける正規表現。この語が無い画面には確認ダイアログを求めない"
        },
        "linkSemantics": {
          "type": "object",
          "required": ["objectNameExpression", "backLinkPattern"],
          "properties": {
            "objectNameExpression": { "type": "string", "minLength": 1 },
            "backLinkPattern": { "type": "string", "minLength": 1 },
            "mobileListClass": { "type": "string", "minLength": 1 },
            "navigationTextPattern": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "backNavigationUsage": {
      "type": "object",
      "required": ["purpose", "placement", "target", "gapToPageHeading", "gapAfterPageHeading"],
      "properties": {
        "purpose": { "const": "back-navigation" },
        "placement": { "const": "before-page-heading" },
        "target": { "type": "string", "pattern": "^/" },
        "gapToPageHeading": { "const": "space.4" },
        "gapAfterPageHeading": { "const": "space.8" }
      },
      "additionalProperties": false
    },
    "toolbarUsage": {
      "type": "object",
      "required": ["placement", "gapBeforeTable", "search"],
      "properties": {
        "placement": { "const": "before-table" },
        "gapBeforeTable": { "const": "space.3" },
        "search": {
          "type": "object",
          "required": ["component", "ariaLabel", "placeholder", "desktopWidth", "narrowWidth", "align"],
          "properties": {
            "component": { "const": "component.search-field" },
            "ariaLabel": { "type": "string", "minLength": 1 },
            "placeholder": { "type": "string", "minLength": 1 },
            "desktopWidth": { "const": "16rem" },
            "narrowWidth": { "const": "100%" },
            "align": { "const": "end" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "createActionUsage": {
      "type": "object",
      "required": ["purpose", "screen", "variant", "label", "placement", "opens"],
      "properties": {
        "purpose": { "const": "create", "description": "集合画面から新しいレコードを作る操作。ラベルは題材ごとに変わる" },
        "screen": { "type": "string", "minLength": 1, "description": "この操作を置く画面。manifestのscreens.idと揃える" },
        "variant": { "const": "primary" },
        "label": { "type": "string", "minLength": 1 },
        "placement": { "const": "page-heading-actions" },
        "opens": { "const": "component.drawer" }
      },
      "additionalProperties": false
    },
    "formDrawerUsage": {
      "type": "object",
      "required": ["purpose", "states", "sections", "fields", "submit", "cancel", "onSuccess", "onFailure"],
      "properties": {
        "purpose": { "const": "record-form", "description": "レコードの追加と編集を担うDrawer" },
        "states": {
          "type": "object",
          "required": ["create", "edit"],
          "properties": {
            "create": { "type": "string", "minLength": 1 },
            "edit": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false,
          "description": "Drawerを開いた状態の名前。manifestのrequiredStatesと揃える"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Drawerの内部構造。component契約のimport識別子で書く"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "label", "component"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "component": { "type": "string", "pattern": "^component\\." },
              "required": { "type": "boolean" },
              "inputType": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "submit": { "$ref": "#/$defs/dialogAction" },
        "cancel": { "$ref": "#/$defs/dialogAction" },
        "onSuccess": {
          "type": "object",
          "required": ["toast"],
          "properties": {
            "toast": { "type": "string", "minLength": 1 },
            "reflectIn": { "type": "string", "minLength": 1, "description": "保存結果を反映する先の画面" }
          },
          "additionalProperties": false
        },
        "onFailure": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "alertDialogUsage": {
      "type": "object",
      "required": ["purpose", "state", "trigger", "confirm", "cancel", "content", "onSuccess", "onFailure"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1, "description": "確認ダイアログが守る操作の種類。取り消せない操作の呼び名は題材ごとに変わる" },
        "state": { "type": "string", "minLength": 1, "description": "確認ダイアログを開いた状態の名前。manifestのrequiredStatesと揃える" },
        "trigger": {
          "type": "object",
          "required": ["component", "variant", "label", "placement"],
          "properties": {
            "component": { "const": "component.button" },
            "variant": { "const": "danger-soft" },
            "label": { "type": "string", "minLength": 1 },
            "placement": { "const": "page-heading-actions" }
          },
          "additionalProperties": false
        },
        "confirm": { "$ref": "#/$defs/dialogAction" },
        "cancel": { "$ref": "#/$defs/dialogAction" },
        "content": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "onSuccess": {
          "type": "object",
          "required": ["toast", "navigateTo"],
          "properties": {
            "toast": { "type": "string", "minLength": 1 },
            "navigateTo": { "type": "string", "pattern": "^/" }
          },
          "additionalProperties": false
        },
        "onFailure": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dialogAction": {
      "type": "object",
      "required": ["component", "label"],
      "properties": {
        "component": { "const": "component.button" },
        "variant": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "tableUsage": {
      "type": "object",
      "required": ["variant", "columns", "narrowVariant"],
      "properties": {
        "variant": { "type": "string", "minLength": 1 },
        "narrowVariant": { "type": "string", "minLength": 1 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "width", "minWidth", "align"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "width": { "type": "string", "minLength": 1 },
              "minWidth": { "type": "integer", "minimum": 1 },
              "align": { "enum": ["start", "center", "end"] },
              "isRowHeader": { "type": "boolean" },
              "tabular": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
