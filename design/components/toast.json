{
  "$schema": "../schemas/component.schema.json",
  "id": "component.toast",
  "name": "Toast",
  "implementation": "Toast",
  "import": "@heroui/react",
  "variants": ["default", "accent", "success", "warning", "danger"],
  "sizes": ["md"],
  "defaults": { "variant": "default", "size": "md" },
  "visual": { "surfaceOwner": "component", "outerShadow": "required", "radiusToken": "radius.base" },
  "anatomy": ["toast"],
  "requirements": [
    "成功または失敗した対象を明記する",
    "説明文は敬体で、結果を動詞まで書く",
    "失敗時は画面内にも回復手段を残す"
  ],
  "relatedRules": ["component.approved", "a11y.error-recovery", "state.failure"]
}
