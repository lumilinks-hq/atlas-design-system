{
  "$schema": "../schemas/component.schema.json",
  "version": "1.0.0",
  "id": "component.text-field",
  "name": "TextField",
  "implementation": "TextField",
  "import": "@heroui/react",
  "variants": ["primary", "secondary"],
  "sizes": ["md"],
  "defaults": { "variant": "primary", "size": "md" },
  "visual": { "surfaceOwner": "component", "outerShadow": "allowed", "radiusToken": "radius.base" },
  "anatomy": ["Label", "Description", "FieldError", "Input"],
  "requirements": [
    "入力の目的を示すLabelを常に表示する",
    "補足はDescription、入力エラーはFieldErrorで対象の近くに表示する",
    "メールアドレスにはtype=emailと適切なautocompleteを指定する"
  ],
  "relatedRules": ["component.approved", "a11y.form-label", "a11y.error-recovery"]
}
